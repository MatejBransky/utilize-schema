// fallow configuration: https://fallow.tools/docs
// Every entry says why it exists. Prefer fixing the code or the tool config
// over adding an exception here, and never add one only to silence a real
// finding.
{
	"$schema": "./node_modules/fallow/schema.json",
	"minimumVersion": "3.45.0",

	// A source file Fallow cannot parse must fail the run instead of silently
	// disappearing from every analysis.
	"failOnParseError": true,

	// Benchmark harnesses are developer tools, not production entry points.
	"supportEntry": [
		"packages/json-schema/bench/compareRefactor.mjs",
		"packages/json-schema/bench/refactorEntry.ts",
		"packages/json-schema/tsdown.bench.config.ts",
	],

	// Repository policy that boundaries cannot express.
	"rulePacks": ["rule-packs/utilize-policy.jsonc"],

	// Commit hooks and PR CI judge only findings introduced by the change.
	"audit": {
		"gate": "new-only",
	},

	// No `publicPackages`. fallow already reads each package's `main`, `exports`
	// and `bin`, so the public API of every published package counts as used
	// (`fallow list --entry-points`). Listing the packages as public on top of
	// that also stops fallow from reporting unused exports in their internal
	// modules and tests, which hid 17 real findings.

	"ignoreExports": [
		// Every generator package exposes the same API shape on purpose, so a user
		// switches targets by changing only the import. The names are separate
		// exports of separate packages, not two modules behind one barrel, so the
		// shared name cannot resolve to the wrong one. Renaming them per target
		// (`generateZod`, `ZodGenerateOptions`, …) would break that symmetry and
		// every existing user.
		{ "file": "packages/*/src/generator.ts", "exports": ["generate", "GenerateOptions"] },

		// The playground's own copy of the `formatMode` option, used for its UI
		// state across the Zod and Effect targets. It mirrors the generators'
		// `FormatMode` instead of importing one of them, so the app does not tie a
		// shared setting to a single target.
		{ "file": "playground/src/formatMode.ts", "exports": ["FormatMode"] },
	],

	"duplicates": {
		// No percentage threshold on purpose (0 = none, the default): the gate is
		// zero clone groups. The bare `fallow` run fails on every clone group that
		// is not listed in `ignoredClones`, whatever the threshold, and
		// `fallow audit` fails on every clone group a change introduces (see
		// `rules` below). The threshold only sets the exit code of
		// `fallow dupes`, and any value above 0 would let that command pass with
		// new copies under it. Duplication is 0 % today with the reviewed groups
		// left out, so there is no old copy-paste a percentage would need to allow.
		"threshold": 0,

		// Reviewed clone groups. A key holds the group's fingerprint and its
		// number of copies, so a change to the code or a new copy makes the
		// group reportable again.
		"ignoredClones": [
			// `compileFile` and the start of `compileSchema` in the Zod, Effect and
			// TypeScript `compile.ts`. Every generator exposes the same API on
			// purpose (see `ignoreExports`), and each body is one call into
			// `@utilize/json-schema/node`. What is left is the signatures, which
			// name each package's own option types.
			"dup:d627c8ab:2",
			"dup:b0a2b53c:2",
		],

		"ignore": [
			// Generated by each package's `update:suite-baseline` script: the JSON
			// Schema Test Suite tests that generator fails. Zod and Effect fail many
			// of the same `format` tests, so the lists overlap, but each one records
			// its own generator and changes on its own. Not code, so not copy-paste.
			"packages/*/test/suite/knownFailureInstances.ts",
		],
	},

	// The layering promised in the README: the core knows no generator, each
	// generator knows only the core, and the playground may use every target.
	// Tests, scripts, benchmarks and the private test-helper package stay outside
	// the production zones.
	"boundaries": {
		"zones": [
			{ "name": "core", "patterns": ["packages/json-schema/src/**"] },
			{ "name": "zod", "patterns": ["packages/zod/src/**"] },
			{ "name": "effect", "patterns": ["packages/effect/src/**"] },
			{ "name": "typescript", "patterns": ["packages/typescript/src/**"] },
			{ "name": "playground", "patterns": ["playground/src/**"] },
		],
		"rules": [
			{ "from": "core", "allow": [] },
			{ "from": "zod", "allow": ["core"] },
			{ "from": "effect", "allow": ["core"] },
			{ "from": "typescript", "allow": ["core"] },
			{ "from": "playground", "allow": ["core", "zod", "effect", "typescript"] },
		],
		"coverage": {
			"requireAllFiles": true,
			"allowUnmatched": [
				"**/test/**",
				"**/scripts/**",
				"**/bench/**",
				"**/*.config.ts",
				"playground/*.html",
				"packages/test-utils/**",
			],
		},
	},

	"health": {
		// The fallow defaults apply (cyclomatic 20, cognitive 15, CRAP 30, unit
		// size 60) and stay that way.
		//
		// Test code is left out of the complexity checks and the health score
		// only. A table-driven test or a `describe` block with many cases is long
		// on purpose, and splitting it would make it harder to read, not easier.
		// Dead-code and duplication checks still cover every test file.
		// `packages/test-utils` is the private package of shared test helpers;
		// nothing published imports it.
		"ignore": [
			"**/test/**",
			"**/*.test.ts",
			"**/*.test.tsx",
			"packages/test-utils/**",
			// Measurement plumbing is tooling; its branches implement reporting and
			// fixture setup rather than production behavior.
			"packages/json-schema/bench/**",
			"packages/json-schema/tsdown.bench.config.ts",
		],
		"thresholdOverrides": [
			{
				// The component has no branch-heavy logic: the score is six Monaco
				// lifecycle effects plus the imperative handle and ten props. Moving
				// those effects into hooks would need thousands of real editor
				// mount/update/unmount cycles with workers to benchmark honestly, so
				// record the measured ceiling instead of inventing a microbenchmark.
				"files": ["playground/src/monaco/MonacoEditor.tsx"],
				"functions": ["MonacoEditor"],
				"maxCognitive": 16,
				"reason": "Monaco lifecycle hook density, measured at cognitive 16; refactoring requires a browser lifecycle benchmark.",
			},
		],
	},

	"rules": {
		// Dependency hygiene is clean today; keep it from regressing.
		"unused-dev-dependencies": "error",
		"type-only-dependencies": "error",
		"test-only-dependencies": "error",

		// `fallow audit` (the commit hook and the PR gate) only warns about a
		// clone group that a change introduces by default. As an error, a change
		// that copies code (for example from one generator into another) fails
		// the audit instead of passing with a warning.
		"introduced-clone-group": "error",

		// Rule-pack policy is repository law, not an advisory.
		"policy-violation": "error",

		// Every exported signature must be nameable by consumers.
		"private-type-leaks": "error",
	},
}
