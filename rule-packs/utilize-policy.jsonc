// Repository invariants that boundaries and standard rules cannot express.
//
// `generate()` of every generator must run in the browser, so generator
// source may not reach a Node built-in. Only `compile.ts` and `cli.ts`, which
// the browser bundle never imports, are exempt. Three checks share that job,
// because `banned-import` reads only static `import` and `export ... from`
// statements, not `import()` or `require()`:
//
// - `browser-safe-generator-src` (below) bans static imports.
// - `browser-safe-generator-src-require` (below) bans every `require()` call.
//   `banned-call` matches the callee, not its argument, so it cannot ban only
//   the built-ins. The source is ESM, so no `require()` belongs there anyway.
// - `no-restricted-imports` in `oxlint.config.ts` bans dynamic `import()` of a
//   built-in in the same files (`pnpm check:lint`).
//
// The bare list leaves out `sea`, `sqlite` and `test` on purpose: Node only
// resolves those built-ins with the `node:` prefix, and the bare names belong
// to real npm packages.
{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/rule-pack-schema.json",
	"version": 1,
	"name": "utilize-policy",
	"description": "Repository invariants that boundaries and standard rules cannot express.",
	"rules": [
		{
			"id": "browser-safe-generator-src",
			"kind": "banned-import",
			"specifiers": [
				"node:assert",
				"node:async_hooks",
				"node:buffer",
				"node:child_process",
				"node:cluster",
				"node:console",
				"node:constants",
				"node:crypto",
				"node:dgram",
				"node:diagnostics_channel",
				"node:dns",
				"node:domain",
				"node:events",
				"node:fs",
				"node:http",
				"node:http2",
				"node:https",
				"node:inspector",
				"node:module",
				"node:net",
				"node:os",
				"node:path",
				"node:perf_hooks",
				"node:process",
				"node:punycode",
				"node:querystring",
				"node:readline",
				"node:repl",
				"node:stream",
				"node:string_decoder",
				"node:sys",
				"node:timers",
				"node:tls",
				"node:trace_events",
				"node:tty",
				"node:url",
				"node:util",
				"node:v8",
				"node:vm",
				"node:wasi",
				"node:worker_threads",
				"node:zlib",
				"node:sea",
				"node:sqlite",
				"node:test",
				"assert",
				"async_hooks",
				"buffer",
				"child_process",
				"cluster",
				"console",
				"constants",
				"crypto",
				"dgram",
				"diagnostics_channel",
				"dns",
				"domain",
				"events",
				"fs",
				"http",
				"http2",
				"https",
				"inspector",
				"module",
				"net",
				"os",
				"path",
				"perf_hooks",
				"process",
				"punycode",
				"querystring",
				"readline",
				"repl",
				"stream",
				"string_decoder",
				"sys",
				"timers",
				"tls",
				"trace_events",
				"tty",
				"url",
				"util",
				"v8",
				"vm",
				"wasi",
				"worker_threads",
				"zlib",
			],
			"files": ["packages/zod/src/**", "packages/effect/src/**", "packages/typescript/src/**"],
			"exclude": ["packages/*/src/compile.ts", "packages/*/src/cli.ts"],
			"message": "Generator source is bundled into the browser playground; node:* imports belong in compile.ts or cli.ts.",
			"severity": "error",
		},
		{
			"id": "browser-safe-generator-src-require",
			"kind": "banned-call",
			"callees": ["require"],
			"files": ["packages/zod/src/**", "packages/effect/src/**", "packages/typescript/src/**"],
			"exclude": ["packages/*/src/compile.ts", "packages/*/src/cli.ts"],
			"message": "Generator source is ESM and is bundled into the browser playground; use a static import, and keep Node built-ins in compile.ts or cli.ts.",
			"severity": "error",
		},
	],
}
