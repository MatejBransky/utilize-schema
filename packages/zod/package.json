{
	"name": "@utilize/zod",
	"version": "0.6.0",
	"description": "Zod utilities for working with JSON Schema.",
	"keywords": [
		"ast",
		"generator",
		"optimizer",
		"parser"
	],
	"license": "MIT",
	"author": {
		"name": "Matej Bransky",
		"email": "matej.bransky@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MatejBransky/utilize-schema.git",
		"directory": "packages/zod"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepublishOnly": "pnpm build",
		"build": "tsdown",
		"build:dev": "tsdown",
		"check:types": "tsc --noEmit",
		"test": "vitest",
		"test:suite": "vitest run test/jsonSchemaTestSuite.test.ts",
		"update:suite-baseline": "node scripts/update-suite-baseline.mjs",
		"ci:test": "vitest run",
		"dev": "tsdown --watch"
	},
	"dependencies": {
		"@types/toposort": "2.0.7",
		"@utilize/json-schema": "workspace:*",
		"toposort": "2.0.2"
	},
	"devDependencies": {
		"@total-typescript/tsconfig": "catalog:",
		"@types/node": "catalog:",
		"json-schema-test-suite": "github:json-schema-org/JSON-Schema-Test-Suite#e2a68a15cd490750fd6b95e604e4054d7d978d1f",
		"oxfmt": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"zod": ">=4.0.0 <5"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
