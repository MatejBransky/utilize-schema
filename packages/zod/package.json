{
	"name": "@utilize/zod",
	"version": "0.9.0",
	"description": "Zod schema generator for JSON Schema.",
	"keywords": [
		"ast",
		"codegen",
		"generator",
		"json-schema",
		"json-schema-to-zod",
		"optimizer",
		"parser",
		"typescript",
		"zod"
	],
	"license": "MIT",
	"author": {
		"name": "Matej Bransky",
		"email": "matej.bransky@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MatejBransky/utilize-schema.git",
		"directory": "packages/zod"
	},
	"bin": {
		"utilize-zod": "./dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.mjs"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"default": "./dist/runtime.mjs"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepublishOnly": "pnpm build",
		"build": "tsdown",
		"build:dev": "tsdown",
		"check:types": "tsc --noEmit",
		"test": "vitest",
		"test:suite": "vitest run test/jsonSchemaTestSuite.test.ts",
		"update:suite-baseline": "node scripts/update-suite-baseline.mjs",
		"ci:test": "vitest run",
		"dev": "tsdown --watch"
	},
	"dependencies": {
		"@types/toposort": "2.0.7",
		"@utilize/json-schema": "workspace:*",
		"js-yaml": "5.4.2",
		"toposort": "2.0.2"
	},
	"devDependencies": {
		"@total-typescript/tsconfig": "catalog:",
		"@types/node": "catalog:",
		"json-schema-test-suite": "github:json-schema-org/JSON-Schema-Test-Suite#e2a68a15cd490750fd6b95e604e4054d7d978d1f",
		"oxfmt": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"zod": ">=4.0.0 <5"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
