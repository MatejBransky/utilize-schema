{
	"name": "@utilize/zod",
	"version": "0.4.1",
	"description": "Zod utilities for working with JSON Schema.",
	"keywords": [
		"ast",
		"generator",
		"optimizer",
		"parser"
	],
	"license": "MIT",
	"author": {
		"name": "Matej Bransky",
		"email": "matej.bransky@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git@github.com:MatejBransky/utilize-schema.git",
		"directory": "packages/core"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepublishOnly": "pnpm build",
		"build": "tsdown",
		"build:dev": "tsdown",
		"check:types": "tsc --noEmit",
		"test": "vitest",
		"ci:test": "vitest run",
		"dev": "tsdown --watch"
	},
	"dependencies": {
		"@types/toposort": "2.0.7",
		"@utilize/json-schema": "workspace:*",
		"toposort": "2.0.2",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@apidevtools/json-schema-ref-parser": "catalog:",
		"@total-typescript/tsconfig": "catalog:",
		"@types/lodash": "4.17.27",
		"@types/node": "catalog:",
		"lodash": "4.18.1",
		"oxfmt": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
