{
	"name": "@utilize/json-schema",
	"version": "0.3.0",
	"description": "Utilities for working with JSON Schema.",
	"keywords": [
		"linker",
		"normalizer",
		"optimizer",
		"parser"
	],
	"license": "MIT",
	"author": {
		"name": "Matej Bransky",
		"email": "matej.bransky@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/MatejBransky/utilize-schema.git",
		"directory": "packages/json-schema"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepublishOnly": "pnpm build",
		"build": "tsdown",
		"build:dev": "tsdown",
		"check:types": "tsc --noEmit",
		"test": "vitest",
		"ci:test": "vitest run",
		"dev": "tsdown --watch"
	},
	"dependencies": {
		"@apidevtools/json-schema-ref-parser": "catalog:",
		"dequal": "2.0.3",
		"moize": "6.1.7"
	},
	"devDependencies": {
		"@total-typescript/tsconfig": "catalog:",
		"@types/json-schema": "7.0.15",
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
