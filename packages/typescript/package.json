{
	"name": "@utilize/typescript",
	"version": "0.4.1",
	"description": "TypeScript type generator for JSON Schema.",
	"keywords": [
		"codegen",
		"generator",
		"json-schema",
		"json-schema-to-typescript",
		"schema",
		"types",
		"typescript",
		"typescript-types"
	],
	"license": "MIT",
	"author": {
		"name": "Matej Bransky",
		"email": "matej.bransky@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MatejBransky/utilize-schema.git",
		"directory": "packages/typescript"
	},
	"bin": {
		"utilize-typescript": "./dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepublishOnly": "pnpm build",
		"build": "tsdown",
		"build:dev": "tsdown",
		"check:types": "tsc --noEmit",
		"test": "vitest",
		"test:suite": "vitest run test/jsonSchemaTestSuite.test.ts",
		"ci:test": "vitest run",
		"dev": "tsdown --watch"
	},
	"dependencies": {
		"@utilize/json-schema": "workspace:*"
	},
	"devDependencies": {
		"@total-typescript/tsconfig": "catalog:",
		"@types/node": "catalog:",
		"@utilize/test-utils": "workspace:*",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
