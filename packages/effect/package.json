{
	"name": "@utilize/effect",
	"version": "0.3.0",
	"description": "Effect Schema generator for JSON Schema.",
	"keywords": [
		"codegen",
		"effect",
		"effect-schema",
		"generator",
		"json-schema",
		"schema",
		"typescript"
	],
	"license": "MIT",
	"author": {
		"name": "Matej Bransky",
		"email": "matej.bransky@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MatejBransky/utilize-schema.git",
		"directory": "packages/effect"
	},
	"bin": {
		"utilize-effect": "./dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepublishOnly": "pnpm build",
		"build": "tsdown",
		"build:dev": "tsdown",
		"check:types": "tsc --noEmit",
		"test": "vitest",
		"ci:test": "vitest run",
		"test:suite": "vitest run test/jsonSchemaTestSuite.test.ts",
		"update:suite-baseline": "node scripts/update-suite-baseline.mjs",
		"dev": "tsdown --watch"
	},
	"dependencies": {
		"@utilize/json-schema": "workspace:*",
		"js-yaml": "5.4.2"
	},
	"devDependencies": {
		"@total-typescript/tsconfig": "catalog:",
		"@types/node": "catalog:",
		"@utilize/zod": "workspace:*",
		"effect": "catalog:",
		"json-schema-test-suite": "github:json-schema-org/JSON-Schema-Test-Suite#e2a68a15cd490750fd6b95e604e4054d7d978d1f",
		"oxfmt": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"effect": ">=4.0.0 <5"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
