{
	"name": "@utilize/effect",
	"version": "0.1.0",
	"description": "Effect Schema generator for JSON Schema.",
	"keywords": [
		"effect",
		"generator",
		"json-schema",
		"schema"
	],
	"license": "MIT",
	"author": {
		"name": "Matej Bransky",
		"email": "matej.bransky@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MatejBransky/utilize-schema.git",
		"directory": "packages/effect"
	},
	"bin": {
		"utilize-effect": "./dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepublishOnly": "pnpm build",
		"build": "tsdown",
		"build:dev": "tsdown",
		"check:types": "tsc --noEmit",
		"test": "vitest",
		"ci:test": "vitest run",
		"dev": "tsdown --watch"
	},
	"dependencies": {
		"@utilize/json-schema": "workspace:*",
		"js-yaml": "5.4.2"
	},
	"devDependencies": {
		"@total-typescript/tsconfig": "catalog:",
		"@types/node": "catalog:",
		"@utilize/zod": "workspace:*",
		"effect": "catalog:",
		"oxfmt": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"effect": ">=4.0.0 <5"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
