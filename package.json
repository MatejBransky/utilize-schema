{
	"name": "utilize-schema",
	"private": true,
	"description": "Generate Zod and Effect Schema codecs or plain TypeScript types from JSON Schema.",
	"keywords": [
		"codegen",
		"effect",
		"generator",
		"json-schema",
		"json-schema-to-typescript",
		"json-schema-to-zod",
		"parser",
		"schema",
		"typescript",
		"utilities",
		"validation",
		"zod"
	],
	"license": "MIT",
	"author": {
		"name": "Matej Bransky",
		"email": "matej.bransky@gmail.com"
	},
	"type": "module",
	"scripts": {
		"preinstall": "node scripts/check-package-manager.mjs",
		"build": "pnpm run --recursive --aggregate-output --reporter-hide-prefix --if-present build",
		"build:dev": "pnpm run --recursive --aggregate-output --reporter-hide-prefix --if-present build:dev",
		"badge:coverage": "node scripts/coverage-badge.mjs",
		"check:coverage-badge": "node scripts/coverage-badge.mjs --check",
		"check:format": "oxfmt --check .",
		"check:lint": "oxlint packages playground",
		"check:types": "pnpm run --recursive --aggregate-output --reporter-hide-prefix --if-present check:types",
		"format": "oxfmt .",
		"test": "pnpm run --recursive --parallel --aggregate-output --reporter-hide-prefix --if-present test",
		"bench": "pnpm --filter @utilize/json-schema bench",
		"ci:test": "pnpm run --recursive --aggregate-output --reporter-hide-prefix --if-present ci:test",
		"ci:version": "pnpm changeset version",
		"ci:publish": "pnpm changeset publish",
		"verify": "pnpm build:dev && pnpm check:format && pnpm check:lint && pnpm check:types && pnpm ci:test",
		"security": "pnpm audit --audit-level=high",
		"fallow": "fallow",
		"fallow:audit": "fallow audit",
		"fallow:badge": "node scripts/fallow-badge.mjs",
		"check:fallow-badge": "node scripts/fallow-badge.mjs --check",
		"fallow:coverage": "node scripts/fallow-coverage.mjs",
		"hooks:install": "fallow hooks install --target git",
		"example": "pnpm --filter playground dev"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@cloudflare/oxlint-config": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"fallow": "catalog:",
		"fallow-type-aware": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"tsrs": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.28.12"
}
